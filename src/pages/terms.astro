---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.ts';
const updated = 'September 2026';
---

<BaseLayout
  title="Terms of Service"
  description={`The simple terms for using ${SITE.name}: free to use, for learning, and provided as-is.`}
  crumbs={[{ label: 'Terms of Service' }]}
>
  <div class="wrap reading">
    <article class="reading-main">
      <header class="reading-head">
        <h1>Terms of Service</h1>
        <p class="muted">Last updated: {updated}</p>
      </header>
      <div class="prose">
        <p>By using {SITE.name} you agree to these simple terms. If you do not agree with them, please do not use the site.</p>

        <h2>Using the site</h2>
        <p>{SITE.name} is free for personal and classroom use. You may use the calculators, lessons, quizzes and games for studying, teaching and homework. There is no account and nothing to buy.</p>

        <h2>What we provide</h2>
        <p>The tools and content are provided as they are, to help you learn. We work to keep the calculators accurate, but we cannot promise the site will be error-free or available at all times.</p>

        <h2>Check important results</h2>
        <p>Use {SITE.name} as a study aid. For anything that really matters, such as graded work or an exam answer, check the result yourself and make sure you understand the steps.</p>

        <h2>Other websites</h2>
        <p>Some pages link to other websites. We do not control them and are not responsible for their content.</p>

        <h2>Fair use</h2>
        <p>Please do not try to break, overload or misuse the site, or copy it wholesale to pass off as your own.</p>

        <h2>Changes</h2>
        <p>These terms may be updated from time to time. The date at the top shows the latest version.</p>

        <h2>Contact</h2>
        <p>Questions? Use the <a href="/contact">contact page</a>.</p>
      </div>
    </article>
  </div>
</BaseLayout>
