---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <div class="wrap nf">
    <Mascot mood="think" size={120} />
    <p class="nf-lcd lcd" aria-hidden="true">404</p>
    <h1>That page doesn't exist</h1>
    <p class="lede">The link may be old or mistyped. These should get you back on track:</p>
    <p class="nf-links">
      <a class="key key--hi" href="/">Home</a>
      <a class="key" href="/calculators">Calculators</a>
      <a class="key" href="/games">Games</a>
    </p>
  </div>
</BaseLayout>

<style>
  .nf {
    padding-block: 48px 80px;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .nf .lede {
    margin-inline: auto;
  }
  .nf-lcd {
    display: inline-block;
    margin: 8px 0 12px;
    padding: 8px 28px;
    font-size: clamp(3rem, 2rem + 6vw, 5.5rem);
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
  }
</style>
