---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import TopicPath from '../../components/TopicPath.astro';
import '../../styles/calc.css';
import { SITE } from '../../config/site.ts';

export async function getStaticPaths() {
  const lessons = await getCollection('learn');
  return lessons.map((entry) => ({ params: { topic: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'learn'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: entry.data.title,
    description: entry.data.description,
    url: new URL(`/learn/${entry.id}`, SITE.url).href,
    learningResourceType: 'Lesson',
    inLanguage: SITE.lang,
    isAccessibleForFree: true,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  crumbs={[{ label: 'Learn', href: '/learn' }, { label: entry.data.title }]}
  jsonLd={jsonLd}
>
  <div class="wrap reading">
    <article class="reading-main">
      <header class="reading-head">
        <p class="eyebrow">Lesson</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
      </header>
      {
        toc.length > 2 && (
          <nav class="toc" aria-label="In this lesson">
            <p class="eyebrow">In this lesson</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>
    <div class="reading-after">
      <TopicPath topic={entry.data.topic} current="learn" />
      <RelatedTools slugs={entry.data.calculators} heading="Calculators for this topic" />
      <RelatedArticles slugs={entry.data.articles} heading="Go deeper" />
    </div>
  </div>
</BaseLayout>
