---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import CalculatorShell from '../../components/calc/CalculatorShell.astro';
import InputField from '../../components/calc/InputField.astro';
---

<CalculatorLayout slug="lcm">
  <CalculatorShell id="lcm-form" emptyText="Enter two or more whole numbers.">
    <InputField name="nums" label="Whole numbers" placeholder="4, 6, 10" inputmode="text" hint="Two or more positive whole numbers, separated by commas or spaces." />
  </CalculatorShell>
</CalculatorLayout>

<script>
  import { mountGcdLcm } from '../../scripts/calculators/gcd-lcm.ts';
  mountGcdLcm('lcm');
</script>
