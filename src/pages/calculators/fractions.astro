---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import CalculatorShell from '../../components/calc/CalculatorShell.astro';
import InputField from '../../components/calc/InputField.astro';
import Segmented from '../../components/calc/Segmented.astro';
---

<CalculatorLayout slug="fractions">
  <CalculatorShell id="frac-form">
    <div class="calc-group">
      <span class="label">First fraction</span>
      <div class="field-row field-row--tight">
        <InputField name="w1" label="Whole" placeholder="optional" inputmode="numeric" />
        <InputField name="n1" label="Numerator" placeholder="3" inputmode="numeric" />
        <InputField name="d1" label="Denominator" placeholder="4" inputmode="numeric" />
      </div>
    </div>
    <Segmented
      name="op"
      legend="Operation"
      options={[
        { value: '+', label: '+ Add' },
        { value: '-', label: '− Subtract' },
        { value: '*', label: '× Multiply' },
        { value: '/', label: '÷ Divide' },
      ]}
    />
    <div class="calc-group">
      <span class="label">Second fraction</span>
      <div class="field-row field-row--tight">
        <InputField name="w2" label="Whole" placeholder="optional" inputmode="numeric" />
        <InputField name="n2" label="Numerator" placeholder="5" inputmode="numeric" />
        <InputField name="d2" label="Denominator" placeholder="6" inputmode="numeric" />
      </div>
    </div>
  </CalculatorShell>
</CalculatorLayout>

<script>
  import '../../scripts/calculators/fractions.ts';
</script>
