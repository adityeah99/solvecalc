---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS } from '../../data/topics.ts';
import '../../styles/calc.css';

const articles = await getCollection('articles');
const groups = TOPICS.map((t) => ({
  topic: t,
  items: articles.filter((a) => a.data.topic === t.id).sort((a, b) => a.data.title.localeCompare(b.data.title)),
})).filter((g) => g.items.length);
---

<BaseLayout
  title="Math Articles"
  description="Plain-English explanations of percentages, fractions, equations, area, averages, probability and angles, each with worked examples."
  crumbs={[{ label: 'Articles' }]}
>
  <div class="wrap articles-index">
    <header class="index-head">
      <h1>Articles</h1>
      <p class="lede">Short explanations of one idea at a time, each with worked examples and a practice question at the end.</p>
    </header>
    {
      groups.map((g) => (
        <section class="index-group" id={g.topic.id} aria-labelledby={`a-${g.topic.id}`}>
          <h2 id={`a-${g.topic.id}`}>{g.topic.name}</h2>
          <ul class="article-list">
            {g.items.map((a) => (
              <li>
                <a class="article-row" href={`/articles/${a.id}`}>
                  <strong>{a.data.title}</strong>
                  <span class="muted">{a.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .articles-index {
    padding-bottom: 40px;
    max-width: 900px;
  }
  .index-head {
    margin-bottom: 12px;
  }
  .index-group {
    margin-top: 32px;
    scroll-margin-top: 90px;
  }
</style>
