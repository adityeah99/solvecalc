---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import TopicPath from '../../components/TopicPath.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import '../../styles/calc.css';
import { SITE } from '../../config/site.ts';
import { topicById } from '../../data/topics.ts';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const topic = topicById(entry.data.topic);
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const published = entry.data.published;
const updated = entry.data.updated;
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: new URL(`/articles/${entry.id}`, SITE.url).href,
    datePublished: published.toISOString().slice(0, 10),
    dateModified: (updated ?? published).toISOString().slice(0, 10),
    inLanguage: SITE.lang,
    author: { '@type': 'Person', name: SITE.authorName },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  crumbs={[{ label: 'Articles', href: '/articles' }, { label: entry.data.title }]}
  jsonLd={jsonLd}
>
  <div class="wrap reading">
    <article class="reading-main">
      <header class="reading-head">
        <p class="eyebrow"><a href={`/articles#${topic.id}`}>{topic.name}</a> · {minutes} min read</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
        <p class="reading-date muted">
          <time datetime={published.toISOString().slice(0, 10)}>{fmtDate(published)}</time>
          {updated && <span> · Updated <time datetime={updated.toISOString().slice(0, 10)}>{fmtDate(updated)}</time></span>}
        </p>
      </header>
      <div class="prose">
        <TableOfContents headings={headings} />
        <Content />
      </div>
    </article>
    <div class="reading-after">
      <TopicPath topic={entry.data.topic} current="learn" />
      <RelatedTools slugs={entry.data.calculators} heading="Try it with a calculator" />
      <RelatedArticles slugs={entry.data.related} />
    </div>
  </div>
</BaseLayout>
