---
// The mark is an "=" key cap: the moment you get the answer.
// Colours are literal so the same SVG works as the favicon.
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<svg viewBox="0 0 40 40" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <rect x="2" y="6" width="36" height="32" rx="9" fill="#0e151f"></rect>
  <rect x="2" y="2" width="36" height="32" rx="9" fill="#1b2533"></rect>
  <rect x="6.5" y="6" width="27" height="23" rx="6" fill="#2d3a4d"></rect>
  <path d="M13 14.5h14M13 21.5h14" stroke="#f2dd3d" stroke-width="3.4" stroke-linecap="round"></path>
</svg>
