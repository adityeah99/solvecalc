---
import type { CollectionEntry } from 'astro:content';
import { blogCategory } from '../data/blog.ts';
import BlogArt from './BlogArt.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: H = 'h3' } = Astro.props;
const cat = blogCategory(post.data.category);
---

<li>
  <a class="post-card" href={`/blog/${post.id}`}>
    <span class={`post-cover tone-${post.data.tone}`}>
      <BlogArt name={post.data.icon} />
    </span>
    <span class="post-card-body">
      <span class="pill">{cat?.label}</span>
      <H>{post.data.title}</H>
      <p>{post.data.description}</p>
      <span class="post-card-more">Read it →</span>
    </span>
  </a>
</li>

<style>
  .post-card-body h2,
  .post-card-body h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.25;
  }
  .post-card-body .pill {
    align-self: flex-start;
  }
</style>
