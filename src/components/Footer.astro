---
import { SITE, SOCIAL } from '../config/site.ts';
import Logo from './Logo.astro';

const explore = [
  { label: 'Calculators', href: '/calculators' },
  { label: 'Lessons', href: '/learn' },
  { label: 'Guides', href: '/articles' },
  { label: 'Blog', href: '/blog' },
  { label: 'Math Quizzes', href: '/quizzes' },
  { label: 'Games', href: '/games' },
];
const legal = [
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Disclaimer', href: '/disclaimer' },
  { label: 'Sitemap', href: '/sitemap-index.xml' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
// Tiny inline icon paths, drawn only for networks that have a link set.
const ICONS: Record<string, string> = {
  instagram:
    'M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.26.07 1.64.07 4.83s0 3.57-.07 4.83c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.26.06-1.64.07-4.83.07s-3.57 0-4.83-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.57 2.2 15.19 2.2 12s0-3.57.07-4.83c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.43 2.21 8.81 2.2 12 2.2Zm0 3.65A6.15 6.15 0 1 0 18.15 12 6.15 6.15 0 0 0 12 5.85Zm0 10.15A4 4 0 1 1 16 12a4 4 0 0 1-4 4Zm6.4-10.4a1.44 1.44 0 1 0 1.43 1.44 1.44 1.44 0 0 0-1.43-1.44Z',
  youtube:
    'M23 7.5a3 3 0 0 0-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.5 31 31 0 0 0-.5-4.5ZM9.8 15.3V8.7l5.7 3.3Z',
  tiktok:
    'M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3v11.6a2.4 2.4 0 1 1-2.4-2.4c.24 0 .47.03.7.1V9.2a5.5 5.5 0 0 0-.7-.05 5.4 5.4 0 1 0 5.4 5.4V8.9a7.1 7.1 0 0 0 4 1.25v-3a4.3 4.3 0 0 1-3-1.3Z',
  x: 'M18.9 2H22l-7.1 8.1L23 22h-6.6l-5.2-6.8L5.3 22H2l7.6-8.7L1.5 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.4 4H5.5Z',
};
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/"><Logo /><span>{SITE.name}</span></a>
        <p>{SITE.description}</p>
        {
          SOCIAL.length > 0 && (
            <div class="footer-social">
              {SOCIAL.map((s) => (
                <a class="footer-social-icon" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.network}>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d={ICONS[s.network]} fill="currentColor" />
                  </svg>
                </a>
              ))}
            </div>
          )
        }
      </div>
      <nav aria-labelledby="f-explore">
        <h2 id="f-explore">Explore</h2>
        <ul>
          {explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-labelledby="f-legal">
        <h2 id="f-legal">Legal</h2>
        <ul>
          {legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {year} {SITE.name}. Free to use for learning and teaching.</p>
    </div>
  </div>
</footer>
