---
import { getCollection } from 'astro:content';
import { topicById } from '../data/topics.ts';

interface Props {
  slugs: string[];
  heading?: string;
}
const { slugs, heading = 'Read next' } = Astro.props;
const all = await getCollection('articles');
const items = slugs.map((s) => all.find((a) => a.id === s)).filter((a) => a !== undefined);
---

{
  items.length > 0 && (
    <section class="doc-section">
      <h2>{heading}</h2>
      <ul class="article-list">
        {items.map((a) => (
          <li>
            <a class="article-row" href={`/articles/${a.id}`}>
              <span class="pill">{topicById(a.data.topic).name}</span>
              <strong>{a.data.title}</strong>
              <span class="muted">{a.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
